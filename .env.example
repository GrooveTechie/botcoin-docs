# Hotel Deal Negotiator - Environment Configuration

# Database path (SQLite)
DATABASE_URL=sqlite:///./data/hotel_deals.db

# Gmail OAuth credentials path (download from Google Cloud Console)
# See README.md for setup instructions
GOOGLE_CLIENT_SECRET_FILE=./secrets/client_secret.json

# Gmail OAuth token storage
GOOGLE_TOKEN_FILE=./secrets/token.json

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Safety settings
MIN_SEND_INTERVAL_SECONDS=10
MAX_FOLLOWUPS_PER_THREAD=1

# LLM settings (for future OpenAI integration)
# OPENAI_API_KEY=your-api-key-here
# LLM_PROVIDER=stub  # Options: stub, openai
